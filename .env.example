# Loyverse API
# احصل على Access Token من: https://loyverse.com → Settings → Access Tokens
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_STORE_ID=

# Database (سنستخدمه في المراحل القادمة)
DATABASE_URL="postgresql://user:password@localhost:5432/loyverse_menu"

# Authentication (لاحقاً)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
